PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_portal
DB_SSL=false
# Optional: paste the Aiven CA certificate here. Both multiline text and
# literal \n line breaks are supported. Leave empty when the provider uses a
# public CA trusted by Node.js.
DB_SSL_CA=
# Local development alternative: path to a downloaded CA certificate.
DB_SSL_CA_PATH=./ca.pem

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5173
