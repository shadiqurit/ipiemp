PORT=3003
# Use 127.0.0.1 in production when Nginx is on the same server.
HOST=0.0.0.0
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_portal
DB_SSL=false
# Optional: paste the Aiven CA certificate here. Both multiline text and
# literal \n line breaks are supported. Leave empty when the provider uses a
# public CA trusted by Node.js.
DB_SSL_CA=
# Local development alternative: path to a downloaded CA certificate.
DB_SSL_CA_PATH=./ca.pem

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5173
# Public website URL used in the Yes/No/Maybe email buttons.
PUBLIC_BASE_URL=http://localhost:5173

# Optional location of a production Vue build. When omitted, the backend uses
# ../frontend/dist relative to this backend directory.
FRONTEND_DIST=

# SMTP sender for Outlook calendar meeting invitations. Get these values
# from the mailbox provider's mail-client or "Connect Devices" settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Inbox access used by the Meeting page's "Sync Outlook replies" button.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# Leave user/password empty to reuse SMTP_USER and SMTP_PASSWORD.
IMAP_USER=
IMAP_PASSWORD=
MEETING_TIMEZONE=Asia/Dhaka

# Optional: only needed to add direct Action.Http buttons in addition to the
# standard Outlook calendar invitation. Calendar RSVP and the web buttons
# above work without these Outlook provider settings.
OUTLOOK_PROVIDER_ID=
OUTLOOK_ENTRA_TENANT_ID=
# Use the AppIdUri generated for the provider registration as the audience.
OUTLOOK_ENTRA_AUDIENCE=
OUTLOOK_ENTRA_SCOPE=Meeting.Respond
