# Copy this to .env.oracle on the PC where Oracle is installed.
ORACLE_TRANSFER_ENABLED=true
ORACLE_USER=portal_importer
ORACLE_PASSWORD=YOUR_LOCAL_ORACLE_PASSWORD
# Replace YOUR_SERVICE_NAME with the actual Oracle service/PDB name.
ORACLE_CONNECT_STRING=localhost:1521/YOUR_SERVICE_NAME
ORACLE_SCHEMA=HR
ORACLE_TRANSFER_MAPPING_PATH=./oracle-transfer.mapping.json
